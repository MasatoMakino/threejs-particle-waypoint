{
  "name": "@masatomakino/threejs-particle-waypoint",
  "version": "0.9.4",
  "description": "Particle waypoint module for three.js",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "default": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      }
    }
  },
  "types": "./esm/index.d.ts",
  "files": [
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://MasatoMakino@github.com/MasatoMakino/threejs-particle-waypoint.git"
  },
  "author": "MasatoMakino <unagiinu.g@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@masatomakino/gulptask-demo-page": "^0.10.0",
    "@types/three": "^0.183.1",
    "@vitest/browser-webdriverio": "^4.0.0",
    "@vitest/coverage-istanbul": "^4.0.18",
    "browser-sync": "^3.0.2",
    "prettier": "^3.0.3",
    "three": "^0.183.1",
    "typedoc": "^0.28.0",
    "typescript": "^5.4.3",
    "vitest": "4.0.18",
    "webdriverio": "^10.1.0"
  },
  "peerDependencies": {
    "@masatomakino/particle-waypoint": "^0.8.0",
    "three": ">=0.126.0 <1.0.0"
  },
  "scripts": {
    "test": "vitest --run",
    "test:ci": "xvfb-run --auto-servernum vitest --run",
    "coverage": "vitest --run --coverage",
    "coverage:ci": "xvfb-run --auto-servernum vitest --coverage --run",
    "pre-commit": "prettier --write --ignore-unknown",
    "pre-push": "vitest --run",
    "start:dev": "pnpm run server & pnpm run watch:tsc & pnpm run watch:demo",
    "build": "pnpm run buildTS && pnpm run demo",
    "demo": "gulptask-demo-page --body '<canvas id=\"webgl-canvas\" width=\"1280\" height=\"768\"></canvas>' --copyTargets 'png' 'obj' ",
    "buildTS": "tsc",
    "typedocs": "typedoc --out ./docs/api src/index.ts",
    "server": "browser-sync './docs/demo' -w --port 3000 --no-open",
    "watch:demo": "pnpm run demo -W",
    "watch:tsc": "tsc -W --incremental"
  },
  "bugs": {
    "url": "https://github.com/MasatoMakino/threejs-particle-waypoint/issues"
  },
  "homepage": "https://github.com/MasatoMakino/threejs-particle-waypoint#readme",
  "directories": {
    "doc": "docs",
    "lib": "esm"
  }
}
