{
  "name": "@masatomakino/threejs-particle-waypoint",
  "version": "0.9.5",
  "description": "Particle waypoint module for three.js",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "default": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      }
    }
  },
  "types": "./esm/index.d.ts",
  "files": [
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://MasatoMakino@github.com/MasatoMakino/threejs-particle-waypoint.git"
  },
  "author": "MasatoMakino <unagiinu.g@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@masatomakino/demo-showcase": "^0.1.2",
    "@types/three": "^0.187.0",
    "@vitest/browser-webdriverio": "^5.0.0",
    "@vitest/coverage-istanbul": "5.0.5",
    "prettier": "^3.9.10",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "webdriverio": "^10.1.0"
  },
  "peerDependencies": {
    "@masatomakino/particle-waypoint": "^0.8.0",
    "three": ">=0.126.0 <1.0.0"
  },
  "scripts": {
    "test": "vitest --run",
    "coverage": "vitest --run --coverage",
    "pre-commit": "prettier --write --ignore-unknown",
    "pre-push": "vitest --run",
    "start:dev": "pnpm run watch:tsc & demo-showcase dev --body '<canvas id=\"webgl-canvas\" width=\"1280\" height=\"768\"></canvas>' --port 3000 --host 0.0.0.0",
    "build": "pnpm run buildTS && pnpm run demo",
    "demo": "demo-showcase build --distDir ./docs/demo --body '<canvas id=\"webgl-canvas\" width=\"1280\" height=\"768\"></canvas>'",
    "buildTS": "tsc",
    "watch:tsc": "tsc -W --incremental"
  },
  "bugs": {
    "url": "https://github.com/MasatoMakino/threejs-particle-waypoint/issues"
  },
  "homepage": "https://github.com/MasatoMakino/threejs-particle-waypoint#readme",
  "directories": {
    "doc": "docs",
    "lib": "esm"
  }
}
